{
  "name": "analytics-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:unit": "node --import tsx --import ./tests/setup.ts --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --import ./tests/setup.ts --test --test-concurrency=1 tests/integration/*.test.ts",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
