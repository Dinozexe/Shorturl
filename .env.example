# คัดลอกเป็น .env แล้วแก้ secret — ห้าม commit .env

# --- DB / Redis (dev ผ่าน docker compose) ---
DATABASE_URL=postgresql://shorturl:shorturl@localhost:5442/shorturl
REDIS_URL=redis://localhost:6380

# --- Auth ---
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-another-32-characters-long
ADMIN_EMAIL=you@example.com

# --- URL / cookie ---
PUBLIC_BASE_URL=http://localhost:4001
API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
BEHIND_CLOUDFLARE=false

# --- Link / click ---
SHORT_CODE_LENGTH=5
IP_HASH_SALT=change-me-random-salt
CLICK_RETENTION_DAYS=90
CLICK_FLUSH_SECONDS=60

# --- Internal service ---
INTERNAL_API_KEY=change-me-internal-key
ANALYTICS_URL=http://localhost:4002

# --- SSO (เว้นว่าง = ปิด provider นั้น) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Render only ---
SEED_ON_START=false
